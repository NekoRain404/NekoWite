{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The application's own window ('main'), and every command it may call.\n\nThis is the editor, the settings panel and the agent panel, so it holds the whole declared surface except the two commands that belong to a pet window alone (`desktop_pet_close_own`, `desktop_pet_set_click_through` \u2014 see `capabilities/desktop-pet.json`). Deliberately the whole of it: the boundary this file draws is the pet's, and a main window refused a command the app actually uses would be a regression dressed as a security fix. The commands are declared in `build.rs`'s app manifest; an `allow-` name that is not declared there fails the build rather than granting nothing.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "allow-read-file",
    "allow-stat-file",
    "allow-write-file",
    "allow-create-new-file",
    "allow-delete-file",
    "allow-list-trash",
    "allow-restore-from-trash",
    "allow-clear-trash",
    "allow-list-history",
    "allow-read-history",
    "allow-restore-history",
    "allow-list-dir",
    "allow-save-attachment",
    "allow-resolve-media-path",
    "allow-create-dir",
    "allow-rename-entry",
    "allow-register-vault",
    "allow-open-folder-dialog",
    "allow-save-file-dialog",
    "allow-pick-image-files",
    "allow-import-attachment",
    "allow-watch-folder",
    "allow-ai-complete",
    "allow-ai-cancel",
    "allow-ai-list-models",
    "allow-store-ai-key",
    "allow-load-ai-key",
    "allow-set-master-password",
    "allow-unlock-vault",
    "allow-system-accent-color",
    "allow-take-pending-open",
    "allow-agent-start",
    "allow-agent-stop",
    "allow-agent-open-session",
    "allow-agent-set-config-option",
    "allow-agent-prompt",
    "allow-agent-session-snapshot",
    "allow-agent-session-capabilities",
    "allow-agent-list-sessions",
    "allow-agent-load-session",
    "allow-agent-close-session",
    "allow-agent-permission-answer",
    "allow-agent-permission-grants",
    "allow-agent-permission-grant-revoke",
    "allow-agent-cancel-run",
    "allow-agent-registry-read",
    "allow-agent-registry-add",
    "allow-agent-registry-set-enabled",
    "allow-agent-catalogue-read",
    "allow-agent-profile-read",
    "allow-agent-profile-write",
    "allow-agent-config-document",
    "allow-agent-config-edit",
    "allow-agent-credentials-write",
    "allow-agent-skills-read",
    "allow-agent-skills-preview",
    "allow-agent-skills-import",
    "allow-agent-skills-set-enabled",
    "allow-desktop-pet-state",
    "allow-desktop-pet-windows",
    "allow-desktop-pet-open",
    "allow-desktop-pet-disable",
    "allow-desktop-pet-set-visible",
    "allow-desktop-pet-capabilities",
    "allow-desktop-pet-care-read",
    "allow-desktop-pet-tasks",
    "allow-desktop-pet-appearance",
    "allow-desktop-pet-library",
    "allow-desktop-pet-import-character",
    "allow-desktop-pet-catalogue",
    "allow-desktop-pet-adopt-character",
    "allow-desktop-pet-open-task",
    "allow-desktop-pet-read-settings",
    "allow-desktop-pet-update-settings",
    "allow-desktop-pet-open-settings"
  ]
}
