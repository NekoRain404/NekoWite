{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nekowite",
  "version": "0.1.0",
  "identifier": "dev.nekowite.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "NekoWite",
      "width": 1280,
      "height": 820,
      "minWidth": 860,
      "minHeight": 560,
      "decorations": false,
      "center": true
    }],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["attachments/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}